[Unit]
Description=CF AI Card WeCom egress proxy bridge
After=network-online.target docker.service
Wants=network-online.target docker.service

[Service]
Type=simple
# The Windows SSH tunnel listens on host loopback (10808). Expose it only on
# the private production Compose gateway so the API container can reach it.
ExecStart=/usr/bin/socat TCP-LISTEN:10809,bind=172.21.0.1,reuseaddr,fork TCP:127.0.0.1:10808
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
